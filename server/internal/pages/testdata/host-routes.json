              "X-Frame-Options": ["DENY"], "X-Content-Type-Options": ["nosniff"]},
      "lacks": {"Content-Security-Policy": ["challenges.cloudflare.com", "avatars.githubusercontent.com"], "X-Robots-Tag": ["noindex"], "Set-Cookie": [""]}
    },
    "app": {
      "path": "/login",
