# bot-link settings for compose.yaml. Copy to .env, fill in, keep .env private (it holds secrets; never commit it).
# SELF-HOSTING.md explains each one. A line starting with # is off; the server's default then applies.

# ---- database (compose.yaml builds BOTLINK_DATABASE_URL from it). Use hex: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- mode. prod: dev sign-in and the stub human check are refused, cookies are Secure. dev: a local trial only.
BOTLINK_ENV=prod

# ---- where people reach it: the public https origin of the dashboard (no trailing slash)
BOTLINK_APP_ORIGIN=https://botlink.example.org
# Passkeys are bound to this name for good: changing it later locks every passkey out (SELF-HOSTING.md).
# Default: the host of BOTLINK_APP_ORIGIN.
#BOTLINK_WEBAUTHN_RP_ID=botlink.example.org
#BOTLINK_WEBAUTHN_ORIGIN=https://botlink.example.org

# ---- three hosts instead of one (optional; set both or neither, the site host needs both and an explicit RP ID)
#BOTLINK_APP_HOST=app.example.org
#BOTLINK_API_HOST=api.example.org
#BOTLINK_SITE_HOST=example.org

# ---- sign-in: your own OAuth apps. Callback: <BOTLINK_APP_ORIGIN>/app/v1/auth/github/callback (or /google/callback)
#BOTLINK_GITHUB_CLIENT_ID=
#BOTLINK_GITHUB_CLIENT_SECRET=
#BOTLINK_GOOGLE_CLIENT_ID=
#BOTLINK_GOOGLE_CLIENT_SECRET=
# Dev sign-in: anyone can sign in as anyone. Local trials only; the server refuses it with BOTLINK_ENV=prod.
#BOTLINK_DEV_LOGIN=1

# ---- human check before an approval. With BOTLINK_ENV=prod it must be real: make your own Turnstile widget and set both.
#BOTLINK_HUMAN_CHECK=real
#BOTLINK_TURNSTILE_SITE_KEY=
#BOTLINK_TURNSTILE_SECRET=

# ---- who may open /admin (verified account emails, comma-separated). Empty: no admin area.
#BOTLINK_ADMIN_EMAILS=you@example.org

# ---- the client people run (npx -y <it>). Default: <BOTLINK_APP_ORIGIN>/dl/botlink.tgz, served by this image.
#BOTLINK_CLIENT_URL=

# ---- the "Self-host it" link on the landing page, docs and trust page: https://github.com/<owner>/<repository> only
#BOTLINK_SOURCE_URL=

# ---- only behind Cloudflare: take the visitor's address from CF-Connecting-IP (anywhere else visitors could forge it)
#BOTLINK_TRUST_CF=1

# ---- payments stay off (the default). Analytics are off unless both keys are set; leave them unset.
#BOTLINK_PAYWALL=off
#BOTLINK_POSTHOG_KEY=
#BOTLINK_ANALYTICS_HASH_KEY=

# ---- abuse limits (defaults shown; SELF-HOSTING.md has the full list)
#BOTLINK_STORAGE_CEILING_MB=64
#BOTLINK_STORAGE_TOTAL_MB=8192
#BOTLINK_SIGNUP_PER_IP_HOUR=10
#BOTLINK_SIGNUP_PER_IP_DAY=30
#BOTLINK_MAX_WAITS=8400

# ---- publish the server on another address than 127.0.0.1:8811 of this machine (compose.yaml only)
#BOTLINK_PUBLISH=127.0.0.1:8811
